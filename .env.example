# ==============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
# cp .env.example .env
#
# NUNCA commite o arquivo .env no Git (ele está protegido no .gitignore)
# ==============================================================================

# Ambiente da aplicação (development | production)
FLASK_ENV=development

# Chave secreta de sessão Flask (Gere uma chave segura em produção)
# Exemplo de comando para gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=chave-secreta-de-desenvolvimento-troque-em-producao

# Caminho do banco de dados SQLite local
DATABASE_PATH=maceio_turismo.db

# Configurações do administrador inicial para seed
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=DefinaSuaSenhaSegura2025!

# Configuração de segurança de cookies (true em HTTPS/produção, false em desenvolvimento HTTP)
SESSION_COOKIE_SECURE=false

# Limite máximo de payload em bytes (padrão 1 MB = 1048576)
MAX_CONTENT_LENGTH=1048576
